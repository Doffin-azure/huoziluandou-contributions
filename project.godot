; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="炼字狱"
config/description="炼字成词，破狱而行。汉字构筑 Roguelike。"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/lianziyu-icon.png"
run/max_fps.mobile=30

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
Database="*res://src/autoload/database.gd"
GameState="*res://src/autoload/game_state.gd"
SaveManager="*res://src/autoload/save_manager.gd"
Settings="*res://src/autoload/settings.gd"
Music="*res://src/autoload/music.gd"
Ink="*res://src/ui/ink.gd"
Achievements="*res://src/autoload/achievements.gd"
Router="*res://src/autoload/router.gd"
MusicManager="*res://src/autoload/music_manager.gd"
PauseMenu="*res://src/ui/pause_menu.gd"
Debug="*res://src/debug/debug_console.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input]

