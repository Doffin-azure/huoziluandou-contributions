      "hook": "RoomRun / Expedition / GameState 节点结算",
      "unit": "个",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "unique_events",
      "name": "不同事件",
      "method": "去重计数",
      "scopes": [
        "累计"
