      "unit": "种污染",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "polluted_word_tiles",
      "name": "污染字组词",
      "method": "累加",
      "scopes": [
        "累计"
      ],
      "rule": "成功多字词中的带污染字块数。1字多污染只计1，同一 play_id 去重；普通签单独不算污染。",
      "hook": "AchievementBattle.finish_play：出字前污染快照",
      "unit": "字",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "replicate_removed",
      "name": "蔓生未复制即移除",
      "method": "累加",
      "scopes": [
        "单战"
