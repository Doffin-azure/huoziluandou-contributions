  "tiers": {
    "素玉": {
      "base": "#C7CDB1",
      "edge": "#E2DDC4",
      "etch": "#6A8D78",
      "finish": "温润白玉，少量天然沁色"
    },
    "青玉": {
      "base": "#71988C",
      "edge": "#C0CDB1",
      "etch": "#345F5B",
      "finish": "青玉细纹，保留自然磨痕"
    },
    "金縫": {
      "base": "#89A394",
      "edge": "#B59A60",
      "etch": "#375E56",
      "finish": "青白玉，局部细金补缝"
