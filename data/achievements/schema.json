  "metrics": [
    {
      "id": "word_plays",
      "name": "成功组词",
      "method": "累加",
      "scopes": [
        "累计",
        "单战",
        "单回合"
      ],
      "rule": "每个成功结算的多字词计1次。单打、无效连线、效果重演不计；结阵在实际发动时计。",
      "hook": "AchievementBattle.finish_play：成功多字词快照",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "unique_words",
      "name": "不同词语",
      "method": "去重计数",
      "scopes": [
        "累计",
        "单局",
        "单战"
      ],
      "rule": "按词语ID去重。效果重演不新增；失败连线不计。",
      "hook": "AchievementBattle.finish_play：WordData.id 去重",
      "unit": "种",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "battle_wins",
      "name": "战斗胜利",
      "method": "累加",
      "scopes": [
        "累计",
        "单局"
      ],
      "rule": "战斗胜利结算成功计1次；同一 battle_id 只计一次。",
      "hook": "BattleScreen._check_outcome → AchievementBattle.finish",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "run_wins",
      "name": "冒险通关",
      "method": "累加",
      "scopes": [
        "累计"
      ],
      "rule": "正式冒险完成最终胜利结算计1次；同一 run_id 只计一次。",
      "hook": "RoomRun / Expedition 最终通关；EventBus.run_ended",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "attack_damage",
      "name": "一次攻击伤害",
      "method": "取最大",
      "scopes": [
        "单次"
      ],
      "rule": "同一次攻击所有实际命中段的扣血与吸盾之和。排除溢出伤害、污染伤害、灼烧等非攻击伤害。",
      "hook": "BattleState.deal_damage / begin、end_attack_sequence：实际扣血与吸盾",
      "unit": "伤害",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "persistent_shield",
      "name": "持久盾峰值",
      "method": "取最大",
      "scopes": [
        "单战"
      ],
      "rule": "玩家持久盾变化后记录当前值。临时格挡不计。",
      "hook": "Combatant.feedback + AchievementBattle.sample：玩家持久盾",
      "unit": "点",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "flawless_wins",
      "name": "无损获胜",
      "method": "累加",
      "scopes": [
        "累计"
      ],
      "rule": "战斗胜利且本战实际失去生命为0。自伤与污染伤害也计入失血，先受伤再治疗不算无损。",
      "hook": "玩家 Combatant.feedback 累计实际失血 + 战斗胜利",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "energy_peak",
      "name": "储能峰值",
      "method": "取最大",
      "scopes": [
        "单战"
      ],
      "rule": "玩家储能变化后记录当前值。只记实际获得，不记预览。",
      "hook": "BattleState.add_energy / spend_energy；出字前后采样",
      "unit": "点",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "energy_spent",
      "name": "单次出字耗能",
      "method": "取最大",
      "scopes": [
        "单次"
      ],
      "rule": "同一 play_id 内实际支付的储能合计，含效果重演的再次支付。金币抵扣消耗的储能也计；退款不倒扣。",
      "hook": "BattleState.spend_energy → 当前 play_id 汇总",
      "unit": "点",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "heat_peak",
      "name": "热度峰值",
      "method": "取最大",
      "scopes": [
        "单战"
      ],
      "rule": "热度变化后记录实际当前值；提高热容不算热度增加。",
      "hook": "BattleState.add_heat；出字与回合边界采样",
      "unit": "点",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "overflow_created",
      "name": "溢热生成",
      "method": "累加",
      "scopes": [
        "单战"
      ],
      "rule": "仅计溢热实际生成的自生灼热【热】。满盘未生成、抽回旧字、怪物塞字不计。",
      "hook": "BattleOps.overflow：成功放入自生热后",
      "unit": "字",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "heat_cooled",
      "name": "单次出字降温",
      "method": "取最大",
      "scopes": [
        "单次"
      ],
      "rule": "同一 play_id 内实际减少的热度合计；不能把不足的热度算进去。",
      "hook": "BattleState.add_heat：同次出字实际减少值",
      "unit": "点",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "burn_kills",
      "name": "灼烧击败",
      "method": "累加",
      "scopes": [
        "累计"
      ],
      "rule": "敌人因既有灼烧结算死亡计1次。灼热字造成玩家伤害不计。",
      "hook": "BattleState._enemy_act：灼烧扣血死亡",
      "unit": "名",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "attack_hits",
      "name": "一次攻击段数",
      "method": "取最大",
      "scopes": [
        "单次"
      ],
      "rule": "一次攻击实际结算的命中段数。被盾全挡仍计1段；目标死亡后未结算的剩余段不计。",
      "hook": "BattleState.deal_damage：每段实际结算后",
      "unit": "段",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "gilded_tiles",
      "name": "永久镀金",
      "method": "累加",
      "scopes": [
        "累计",
        "单局"
      ],
      "rule": "己方原字首次获得永久镀金时计1枚；同一字块重复镀金不计。",
      "hook": "GameState.gild_character：己方原字 false → true",
      "unit": "字",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "gild_gold",
      "name": "镀金收益",
      "method": "累加",
      "scopes": [
        "单战"
      ],
      "rule": "仅计镀金实际发放金币。单打与组词均计；融合字块按实际发放数计。其他金币来源不计。",
      "hook": "BattleState 出字镀金收益：earn_gold 实际返回值",
      "unit": "金币",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "refine_uses",
      "name": "精炼成功",
      "method": "累加",
      "scopes": [
        "累计"
      ],
      "rule": "【精炼】成功作用于目标字块计1次。无目标、取消、不满足条件不计。",
      "hook": "BattleState.refine_pair：成功返回前",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "pinned_used",
      "name": "固定字使用",
      "method": "累加",
      "scopes": [
        "单战"
      ],
      "rule": "有效单打或组词使用固定字，每枚字块每个 play_id 计1次。只固定但未使用不计。",
      "hook": "AchievementBattle.begin、finish_play：固定字参与快照",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "fusion_success",
      "name": "融合成功",
      "method": "累加",
      "scopes": [
        "累计"
      ],
      "rule": "实际把两枚字合为一个字块计1次，取消或条件失败不计。",
      "hook": "BattleState.fuse_cards：成功返回前",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "extra_use_spent",
      "name": "额外使用消耗",
      "method": "累加",
      "scopes": [
        "单战"
      ],
      "rule": "额外使用次数实际扣除1时计1次。固定字每回合使用机会不计。",
      "hook": "BattleState 出字消耗：temporary_uses 实际扣除",
      "unit": "次",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "temporary_word_tiles",
      "name": "临时字组词",
      "method": "累加",
      "scopes": [
        "单战"
      ],
      "rule": "成功多字词中的临时字，每个 play_id 每枚字块计1次。普通临时字单打不计。",
      "hook": "AchievementBattle.finish_play：成功多字词临时字快照",
      "unit": "字",
      "filters": "",
      "status": "已接入"
    },
    {
      "id": "pollution_cleansed",
      "name": "净化污染",
      "method": "累加",
      "scopes": [
        "累计",
        "单战"
      ],
      "rule": "实际移除的污染标签数。1字清除2种污染计2；普通签、区域标记与销毁字块不算净化。",
