## 一条线（字串，空格为 ""）里最长的词谱词；同长取靠前的；没有返回 {}
static func longest_in(line: Array) -> Dictionary:
	var best := {}
	for i in line.size():
		var text := ""
		for j in range(i, mini(i + 4, line.size())):
			if str(line[j]).is_empty():
				break
			text += line[j]
			if text.length() >= 2 and WORDS.has(text) and (best.is_empty() or text.length() > best.w.length()):
				best = {"w": text, "from": i, "to": j}
	return best


## 版面 grid[行][列]（"" 为空）→ {"words": {词: [格 Vector2i(行,列)...]}, "cells": {格: 次数}}
static func scan(grid: Array) -> Dictionary:
	var words := {}
	var cells := {}
	var n := grid.size()
	for r in n:
		var hit := longest_in(grid[r])
		if not hit.is_empty():
			_add(words, cells, hit.w, range(hit.from, hit.to + 1).map(func(c): return Vector2i(r, c)))
	for c in n:
		var col: Array = []
		for r in n:
			col.append(grid[r][c])
		var hit := longest_in(col)
		if not hit.is_empty():
			_add(words, cells, hit.w, range(hit.from, hit.to + 1).map(func(r): return Vector2i(r, c)))
	return {"words": words, "cells": cells}


static func _add(words: Dictionary, cells: Dictionary, w: String, pos: Array) -> void:
	if not words.has(w):
		words[w] = pos
	for p in pos:
		cells[p] = int(cells.get(p, 0)) + 1


## 词谱里用到的字（掉落池用）
static func glyphs() -> String:
	var s := ""
	for w in WORDS:
		for ch in w:
			if not s.contains(ch):
				s += ch
	return s


